{
  "name": "@local/dsh-dblclick-bottom",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Double-click a conversation panel to scroll: the lower half to the bottom, the upper half to the newest of your own messages, auto-loading older history at the boundary.",
  "repository": {
    "type": "git",
    "url": "https://github.com/liren2272-hue/dsh-dblclick-bottom.git"
  },
  "bugs": {
    "url": "https://github.com/liren2272-hue/dsh-dblclick-bottom/issues"
  },
  "homepage": "https://github.com/liren2272-hue/dsh-dblclick-bottom#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
